diff --git a/src/core/utils/llm_tool_call.py b/src/core/utils/llm_tool_call.py
index 15a99ae..e966050 100644
--- a/src/core/utils/llm_tool_call.py
+++ b/src/core/utils/llm_tool_call.py
@@ -167,6 +167,75 @@ async def create_llm_usable_execution(
     if should_strip_auto_reason_argument(instance.execute, call_kwargs):
         call_kwargs.pop("reason", None)
 
+    # ──────────────────────────────────────────────────────────────────
+    # [本地补丁 2026-10-12] LLM 工具调用路径也发布「执行前事件」。
+    #
+    # 背景：agent 模式的聊天器（default_chatter / neo_default_chatter）走
+    # ``run_tool_call`` → 本函数直接 ``_wrap_execute``，既不经过
+    # ActionManager.execute_action（before_action_call），也不经过
+    # ToolManager.execute_tool（before_tool_call）。于是「在生图前改写参数」
+    # 这类插件（如 char_prompt_guard）在真实对话里永远收不到通知。
+    # 这里补发两条事件，参数结构与原发布点保持一致，插件侧无需改动。
+    #
+    # [修订 2026-10-12 二版] 额外带上 ``stream_id``：本函数本来就拿到了它，
+    # 而官方发布点只带 ``message``。当调用方没有传 message（agent 编排器自己
+    # 发起工具调用时很常见）时，插件就完全拿不到会话，读不到上文 —— 表现为
+    # "插件装上了、事件也收到了，但提取不出角色"。多带一个字段即可根治。
+    # ──────────────────────────────────────────────────────────────────
+    try:
+        from src.core.components.types import EventType
+        from src.kernel.event import get_event_bus
+
+        _bus = get_event_bus()
+        if issubclass(usable_cls, BaseAction):
+            _event_type: Any = EventType.BEFORE_ACTION_CALL
+            # 动作名以新版 ``name`` 为准：``action_name`` 是旧属性，只有用旧属性
+            # 声明的组件才有值（如 nai_artist 的 share_visual）；用 ``name`` 声明的
+            # 组件（如 image_generator_plugin-neo 的 draw_image）直接读
+            # ``action_name`` 会拿到空串，使签名退化成 ``plugin:action:``，
+            # 依赖动作名/签名匹配的插件就再也认不出这个组件。
+            _action_name = str(
+                getattr(instance, "name", "") or getattr(instance, "action_name", "")
+            )
+            _event_params: dict[str, Any] = {
+                "signature": f"{getattr(plugin, 'plugin_name', '')}:action:{_action_name}",
+                "action_name": _action_name,
+                "action_description": (
+                    getattr(instance, "description", "")
+                    or getattr(instance, "action_description", "")
+                ),
+                "args": dict(call_kwargs),
+                "message": message,
+                "stream_id": stream_id or "",
+            }
+        elif issubclass(usable_cls, BaseTool):
+            _event_type = EventType.BEFORE_TOOL_CALL
+            _tool_name = str(
+                getattr(instance, "name", "") or getattr(instance, "tool_name", "")
+            )
+            _event_params = {
+                "signature": f"{getattr(plugin, 'plugin_name', '')}:tool:{_tool_name}",
+                "tool_name": _tool_name,
+                "tool_description": (
+                    getattr(instance, "description", "")
+                    or getattr(instance, "tool_description", "")
+                ),
+                "args": dict(call_kwargs),
+                "message": message,
+                "stream_id": stream_id or "",
+            }
+        else:
+            _event_type = None
+
+        if _event_type is not None and _bus.get_subscribers(_event_type):
+            _, _modified = await _bus.publish(_event_type, _event_params)
+            _new_args = _modified.get("args")
+            if isinstance(_new_args, dict):
+                call_kwargs = _new_args
+    except Exception:
+        # 与框架其它发布点一致：事件失败不阻断组件执行，静默降级
+        pass
+
     execution = instance._wrap_execute(**call_kwargs)
     if task_observer is not None:
         execution.add_task_observer(task_observer)
